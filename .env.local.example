# Copy to .env.local and fill in once you've created a Supabase project.
# Until these are set, the app runs against an in-memory demo dataset
# (see lib/data/index.ts) — no Supabase needed for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the magic-link redirect URL (/auth/callback). Must also be
# added to Supabase's Auth > URL Configuration > Redirect URLs allow-list,
# or Supabase silently falls back to the bare Site URL and the login link
# never lands on /auth/callback to establish a session.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used by Server Actions for admin writes and public sign-up.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by lib/email.ts to send transactional emails (e.g. the
# "betaling ontvangen" mail when an admin marks a reservation as paid) via
# Resend's API — separate from Supabase's own auth-email SMTP config. Without
# this set, lib/email.ts logs a warning and skips sending rather than failing
# the admin action that triggered it.
RESEND_API_KEY=
